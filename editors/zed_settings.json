// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)

// location: ~/.config/zed/settings.json

{
  "git": {
    "inline_blame": {
      "show_commit_summary": false,
      "enabled": false
    }
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "hide_mouse": "never",
  "cli_default_open_behavior": "new_window",
  "search": {
    "center_on_match": true,
    "regex": true
  },
  "colorize_brackets": true,
  "completion_menu_scrollbar": "auto",
  "indent_guides": {
    "coloring": "indent_aware",
    "background_coloring": "indent_aware"
  },
  "tab_size": 2,
  "vim": {
    "cursor_shape": {
      "insert": "bar"
    },
    "toggle_relative_line_numbers": true
  },
  "toolbar": {
    "code_actions": true
  },
  "minimap": {
    "show": "always"
  },
  "scrollbar": {
    "diagnostics": "error",
    "show": "always"
  },
  "relative_line_numbers": "enabled",
  "sticky_scroll": {
    "enabled": true
  },
  "excerpt_context_lines": 3,
  "expand_excerpt_lines": 7,
  "which_key": {
    "enabled": true
  },
  "project_panel": {
    "git_status_indicator": true,
    "bold_folder_labels": true,
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "use_modifier_to_send": true,
    "play_sound_when_agent_done": "when_hidden",
    "sidebar_side": "right",
    "dock": "left",
    "default_model": {
      "provider": "openai",
      "model": "gpt-5.4",
      "enable_thinking": false
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "agent_ui_font_size": 18.0,
  "buffer_line_height": "standard",
  "buffer_font_family": "Rec Mono Casual",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Bearded Icon Theme",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 18.0,
  "buffer_font_size": 20.0,
  "theme": {
    "mode": "dark",
    "light": "Hex Solarized Light Theme",
    "dark": "Chocolate Dark (Blurred)",
  },
}
